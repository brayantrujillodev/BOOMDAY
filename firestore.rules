rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Valida que una URL sea efectivamente un download URL de Firebase Storage del
    // bucket real de este proyecto (boomday-85bef.firebasestorage.app, ver
    // app/google-services.json → storage_bucket), no una URL arbitraria de otro dominio.
    // Un cliente modificado no puede simplemente apuntar videoUrl/thumbnailUrl a
    // cualquier host y hacer que el Feed la reproduzca en autoplay.
    // La URL debe además apuntar a la carpeta del propio usuario (<folder>%2F<uid>%2F...) para
    // que las Cloud Functions (borran con permisos Admin) nunca actúen sobre blobs ajenos.
    // Bucket viejo y nuevo permitidos durante la migración a boomday-e2308; quitar el viejo después.
    function isValidStorageUrl(url, folder) {
      return url.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/(boomday-85bef|boomday-e2308)\\.(firebasestorage\\.app|appspot\\.com)/o/' + folder + '%2F' + request.auth.uid + '%2F[^/]+$');
    }

    // B1 (identidad): fuente confiable = claims del ID token verificado por Firebase Auth
    // (name/picture del proveedor, los mismos que el cliente lee en FirebaseUser.displayName /
    // photoUrl). El /users/{uid} es escribible por el propio cliente, no sirve de ancla.
    function tokenName() { return request.auth.token.get('name', ''); }
    function tokenPicture() { return request.auth.token.get('picture', ''); }
    // Avatar permitido: vacio o exactamente la foto del token (nunca un host arbitrario).
    function isTrustedAvatar(a) { return a is string && (a == '' || a == tokenPicture()); }

    match /videos/{videoId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    // B3: claves exactas que escribe Video.kt (sin campos extra/inventados).
                    && request.resource.data.keys().hasOnly(['videoId', 'userId', 'userName', 'userAvatar', 'videoUrl', 'thumbnailUrl', 'title', 'description', 'duration', 'views', 'likes', 'comments', 'shares', 'hashtags', 'createdAt', 'updatedAt', 'dayKey'])
                    && request.resource.data.hashtags is list
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.userName is string
                    && request.resource.data.userName == tokenName()
                    && isTrustedAvatar(request.resource.data.userAvatar)
                    && request.resource.data.views == 0
                    && request.resource.data.likes == 0
                    && request.resource.data.comments == 0
                    && request.resource.data.shares == 0
                    && request.resource.data.duration is int
                    && request.resource.data.duration >= 3
                    && request.resource.data.duration <= 60
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.description.size() <= 500
                    && request.resource.data.hashtags.size() <= 30
                    && request.resource.data.createdAt is int
                    && request.resource.data.createdAt > request.time.toMillis() - 600000
                    && request.resource.data.createdAt < request.time.toMillis() + 600000
                    && request.resource.data.dayKey is string
                    && request.resource.data.dayKey.size() == 10
                    && isValidStorageUrl(request.resource.data.videoUrl, 'videos')
                    && (
                         request.resource.data.thumbnailUrl == ''
                         || isValidStorageUrl(request.resource.data.thumbnailUrl, 'thumbnails')
                       );

      // El dueño solo puede editar los campos de contenido (título/descripción/hashtags);
      // los contadores (views/likes/comments/shares) quedan fuera de su alcance de escritura
      // para que no pueda inflar sus propias métricas con un update directo.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['title', 'description', 'hashtags', 'updatedAt'])
                    && request.resource.data.title.size() <= 100
                    && request.resource.data.description.size() <= 500
                    && request.resource.data.hashtags.size() <= 30;

      // Cualquier usuario autenticado (no solo el dueño) puede incrementar "views" en
      // exactamente 1 por request — es lo que ya hace VideoRepository.incrementViews(),
      // acotado a un único campo para que no sirva como puerta trasera para editar el resto.
      //
      // FIX (seguridad, P0-1 integridad del ranking): el doc de dedupe
      // videos/{videoId}/views/{uid} debe NO existir antes (exists = estado previo) y existir
      // despues (existsAfter = estado tras la MISMA transaccion/batch). Con solo existsAfter()
      // la regla tambien se cumplia cuando el doc ya existia, y un cliente modificado podia
      // repetir "views + 1" indefinidamente. Asi cada uid solo puede sumar 1 vista por video:
      // la primera operacion crea el dedupe (create-only, ver abajo) y las siguientes fallan
      // porque exists() ya es true. En concurrencia, Firestore evalua las reglas contra el
      // estado vigente al confirmar, asi que solo una de dos transacciones del mismo uid puede
      // aplicarse. VideoRepository.incrementViews() (get -> set dedupe + update increment(1)
      // en una transaccion) cumple exactamente este patron.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                    && request.resource.data.views == resource.data.views + 1
                    && !exists(/databases/$(database)/documents/videos/$(videoId)/views/$(request.auth.uid))
                    && existsAfter(/databases/$(database)/documents/videos/$(videoId)/views/$(request.auth.uid));

      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /views/{userId} {
        // Solo el propio uid lee su doc de dedupe (VideoRepository.incrementViews solo hace
        // transaction.get sobre views/{su uid}); evita enumerar quién vio cada video.
        allow read: if request.auth != null && request.auth.uid == userId;
        // Create-only y solo con el formato que escribe el cliente ({viewedAt}).
        allow create: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.keys().hasOnly(['viewedAt'])
                      && request.resource.data.viewedAt is int;
        allow update, delete: if false;
      }
    }
    match /users/{userId} {
      // FIX (seguridad): antes "allow read: if request.auth != null" dejaba leer el
      // documento de CUALQUIER usuario a cualquiera con sesión (email, blockedUsers
      // incluidos) — una fuga de PII. El cliente nunca lee el /users de otro (name/avatar
      // del autor de un video vienen denormalizados en el propio documento de Video, ver
      // userName/userAvatar), así que no hace falta más que el propio dueño.
      allow read: if request.auth != null && request.auth.uid == userId;
      // B1: el propio usuario escribe su doc (UserRepository: set completo al primer login, update
      // de updatedAt, merge de blockedUsers). Validamos solo los campos presentes para no romper
      // docs legacy ni merges parciales: name null/string<=100, avatar null/''/foto del token o host
      // de foto de Google, uid (si viene) == auth.uid, blockedUsers lista <=500.
      allow create, update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.get('uid', userId) == userId
                    && (request.resource.data.get('name', null) == null
                        || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
                    && (request.resource.data.get('avatar', null) == null
                        || (request.method == 'update'
                            && request.resource.data.avatar == resource.data.get('avatar', null))
                        || (request.resource.data.avatar is string
                            && (request.resource.data.avatar == ''
                                || request.resource.data.avatar == tokenPicture()
                                || request.resource.data.avatar.matches('^https://lh[0-9]\\.googleusercontent\\.com/[^ ]{1,500}$'))))
                    && request.resource.data.get('blockedUsers', []) is list
                    && request.resource.data.get('blockedUsers', []).size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // B3: moderacion. Autorizacion = custom claim `moderator == true` (se asigna con Admin SDK
    // fuera de la app, ver docs/ETAPA_B3_MODERACION.md). Un usuario no puede darselo.
    function isModerator() { return request.auth != null && request.auth.token.get('moderator', false) == true; }
    function videoDoc(id) { return get(/databases/$(database)/documents/videos/$(id)).data; }

    match /reports/{reportId} {
      // Creacion: id determinista <reporterId>_<videoId> (create-only: un reporte por usuario y
      // video; un segundo set cae en la rama update, denegada a no-moderadores). El video debe
      // existir, el reportado debe ser su autor, sin auto-reporte, reason de catalogo cerrado,
      // estado inicial pending, solo las claves permitidas y evidencia validada contra el doc.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['reportId', 'reporterId', 'reportedUserId', 'reportedVideoId', 'reason', 'status', 'createdAt', 'evidence'])
                    && request.resource.data.keys().hasOnly(['reportId', 'reporterId', 'reportedUserId', 'reportedVideoId', 'reason', 'details', 'status', 'createdAt', 'evidence'])
                    && request.auth.uid == request.resource.data.reporterId
                    && request.resource.data.reportedVideoId is string
                    && request.resource.data.reportedVideoId.matches('^[A-Za-z0-9_-]{1,64}$')
                    && reportId.matches('^[A-Za-z0-9_-]{3,200}$')
                    && reportId == request.auth.uid + '_' + request.resource.data.reportedVideoId
                    && request.resource.data.reportId == reportId
                    && exists(/databases/$(database)/documents/videos/$(request.resource.data.reportedVideoId))
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reportedUserId == videoDoc(request.resource.data.reportedVideoId).userId
                    && request.resource.data.reportedUserId != request.auth.uid
                    && request.resource.data.reason in ['spam', 'acoso', 'contenido_sexual', 'violencia', 'ilegal', 'otro']
                    && (!('details' in request.resource.data)
                        || (request.resource.data.details is string && request.resource.data.details.size() <= 300))
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is int
                    && request.resource.data.createdAt > request.time.toMillis() - 600000
                    && request.resource.data.createdAt < request.time.toMillis() + 600000
                    && request.resource.data.evidence is map
                    && request.resource.data.evidence.keys().hasOnly(['videoUrl', 'title', 'videoCreatedAt', 'authorName'])
                    && request.resource.data.evidence.keys().hasAll(['videoUrl', 'title', 'videoCreatedAt', 'authorName'])
                    && request.resource.data.evidence.videoUrl == videoDoc(request.resource.data.reportedVideoId).videoUrl
                    && request.resource.data.evidence.title == videoDoc(request.resource.data.reportedVideoId).title
                    && request.resource.data.evidence.videoCreatedAt == videoDoc(request.resource.data.reportedVideoId).createdAt
                    && request.resource.data.evidence.authorName == videoDoc(request.resource.data.reportedVideoId).userName;

      // Privacidad: ni el reportante lee sus reportes (evita represalias/enumeracion); solo moderadores.
      allow get, list: if isModerator();

      // Moderador: solo status/resolution/reviewedBy/reviewedAt y con transiciones validas:
      //   pending -> in_review            (sin resolution)
      //   in_review -> resolved + resolution dismissed | user_actioned
      // `content_removed` solo lo escribe la Function moderatorRemoveVideo (Admin SDK). No hay
      // retrocesos ni reapertura; resolved es terminal.
      allow update: if isModerator()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'resolution', 'reviewedBy', 'reviewedAt'])
                    && request.resource.data.reviewedBy == request.auth.uid
                    && request.resource.data.reviewedAt is int
                    && request.resource.data.reviewedAt > request.time.toMillis() - 600000
                    && request.resource.data.reviewedAt < request.time.toMillis() + 600000
                    && (
                         (resource.data.status == 'pending'
                          && request.resource.data.status == 'in_review'
                          && !('resolution' in request.resource.data))
                         ||
                         (resource.data.status == 'in_review'
                          && request.resource.data.status == 'resolved'
                          && request.resource.data.resolution in ['dismissed', 'user_actioned'])
                       );

      // Nadie borra reportes desde el cliente.
      allow delete: if false;
    }

    // B3: registro de acciones de moderacion y limites por reportero: solo servidor (Admin SDK).
    match /moderation_actions/{actionId} {
      allow read, write: if false;
    }
    match /report_limits/{uid} {
      allow read, write: if false;
    }

    // B2: metricas operativas escritas solo por Cloud Functions (Admin SDK ignora reglas).
    // Ningun cliente, autenticado o no, puede leer ni escribir.
    match /ops_metrics/{dayKey} {
      allow read, write: if false;
    }
  }
}
