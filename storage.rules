rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{userId}/{fileName} {
      allow read: if request.auth != null;
      // FIX: "allow write" combinaba create/update/delete, pero request.resource es
      // null en un delete — evaluar request.resource.size ahí lanza un error y la regla
      // deniega. Separado para que el dueño pueda borrar su propio video (necesario
      // para VideoRepository.deleteVideo(), que ahora también borra el blob de Storage).
      // B2: solo CREATE (no update): un blob ya validado por validateUploadedVideo no se puede
      // sobrescribir con otro contenido. El nombre debe ser el que genera la app
      // (video_<epoch ms>.<ext>): impide nombres arbitrarios/infinitos y paths raros.
      allow create: if request.auth != null
                   && resource == null
                   && request.auth.uid == userId
                   && fileName.matches('video_[0-9]{10,16}\\.(mp4|webm|3gp|mov)')
                   && request.resource.size > 0
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /thumbnails/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                   && resource == null
                   && request.auth.uid == userId
                   && fileName.matches('thumb_[0-9]{10,16}\\.(jpg|jpeg|png|webp)')
                   && request.resource.size > 0
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    // B3: evidencia de moderacion, solo servidor (Admin SDK ignora reglas). Ningun cliente lee ni escribe.
    match /moderation_evidence/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
